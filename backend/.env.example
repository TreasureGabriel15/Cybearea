# Copy this file to .env and edit it. Never share or commit .env.
PORT=5000

# Set to 1 once the site is served over HTTPS (so the login cookie is HTTPS-only)
COOKIE_SECURE=0

# Optional: Google sign-in (the same Client ID you put in frontend/js/login.js)
GOOGLE_CLIENT_ID=

# Only if the frontend is served from a different address than the backend, e.g. http://localhost:5500
CORS_ORIGINS=
